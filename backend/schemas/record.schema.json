    "translationState": {
      "enum": [
        "source_frozen",
        "queued",
        "draft",
        "translated",
        "structurally_verified",
        "mathematically_reviewed",
        "language_reviewed",
        "built",
        "visually_checked",
        "published",
        "superseded",
        "blocked"
      ]
    },
    "unit": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
