            },
            "unit_kind": {
              "enum": [
                "book",
                "chapter",
                "section",
                "subsection",
                "definition",
                "theorem",
                "lemma",
                "proposition",
                "corollary",
                "proof",
                "example",
                "exercise",
                "hint",
                "answer",
                "solution",
                "figure",
                "table",
                "program",
                "interactive",
                "remark",
                "notation",
                "other"
              ]
            }
          },
          "required": [
            "record_type",
            "resource_id",
            "edition_id",
            "unit_kind",
            "source_local_id",
            "parent_id",
            "order_key",
            "label",
            "title",
            "source_binding",
            "locale_states",
            "concept_ids",
            "prerequisite_ids",
            "rights_id"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
    },
    "orderKey": {
      "pattern": "^[0-9]{4}(?:\\.[0-9]{4})*$",
      "type": "string"
