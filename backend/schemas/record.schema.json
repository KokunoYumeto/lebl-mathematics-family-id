                "type": "string"
              },
              "type": "array"
            },
            "language": {
              "$ref": "#/$defs/languageTag"
            },
            "locale": {
              "$ref": "#/$defs/languageTag"
            },
            "preferred": {
              "minLength": 1,
              "type": "string"
