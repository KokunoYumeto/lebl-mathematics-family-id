            "concept_id",
            "language",
            "locale",
            "preferred",
            "variants",
            "rejected_forms",
            "scope_ids",
            "register",
            "evidence",
            "examples",
            "rights_id"
          ],
          "type": "object"
        }
      ],
      "unevaluatedProperties": false
