                "pedagogical",
                "historical",
                "specialized"
              ]
            },
            "rejected_forms": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            },
            "rights_id": {
              "$ref": "#/$defs/id"
            },
            "scope_ids": {
              "$ref": "#/$defs/idArray"
            },
            "variants": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
