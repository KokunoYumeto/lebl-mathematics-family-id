                }
              ]
            },
            "prerequisite_ids": {
              "$ref": "#/$defs/idArray"
            },
            "record_type": {
              "const": "unit"
            },
            "resource_id": {
              "$ref": "#/$defs/id"
            },
            "rights_id": {
              "$ref": "#/$defs/id"
            },
            "source_binding": {
              "$ref": "#/$defs/sourceBinding"
            },
            "source_local_id": {
              "type": [
                "string",
