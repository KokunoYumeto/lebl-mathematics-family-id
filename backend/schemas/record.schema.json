        "edition_id": {
          "$ref": "#/$defs/id"
        },
        "locator": {
          "minLength": 1,
          "type": "string"
        },
        "source_path": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "edition_id",
        "source_path",
        "locator",
        "content_sha256"
      ],
      "type": "object"
    },
    "term": {
      "allOf": [
