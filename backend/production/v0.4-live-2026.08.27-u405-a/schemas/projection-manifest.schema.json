{
  "$id": "urn:interlanguage:schema:lebl:projection-manifest:0.3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "csv_dialect": {
      "additionalProperties": false,
      "properties": {
        "encoding": {
          "const": "utf-8"
        },
        "line_ending": {
          "const": "LF"
        },
        "quote_all": {
          "const": true
        }
      },
      "required": [
        "encoding",
        "line_ending",
        "quote_all"
      ],
      "type": "object"
    },
    "projections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "encoding": {
                  "enum": [
                    "scalar",
                    "canonical_json",
                    "record_json"
                  ]
                },
                "name": {
                  "pattern": "^[a-z][a-z0-9_]*$",
                  "type": "string"
                },
                "source": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "name",
                "source",
                "encoding"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "file_name": {
            "pattern": "^[a-z][a-z0-9_]*\\.csv$",
            "type": "string"
          },
          "mode": {
            "enum": [
              "records",
              "exercise_support"
            ]
          },
          "name": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "record_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "sort_by": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "name",
          "file_name",
          "mode",
          "record_types",
          "sort_by",
          "columns"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_name": {
      "const": "lebl.backend.projection_manifest"
    },
    "schema_version": {
      "const": "0.3.0"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "csv_dialect",
    "projections"
  ],
  "title": "Lebl backend deterministic CSV projection manifest",
  "type": "object"
}
